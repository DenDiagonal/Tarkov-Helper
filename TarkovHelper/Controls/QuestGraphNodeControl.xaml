<UserControl x:Class="TarkovHelper.Controls.QuestGraphNodeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:TarkovHelper.Services"
             mc:Ignorable="d" 
             d:DesignWidth="220" d:DesignHeight="72"
             Width="220" Height="72"
             Cursor="Hand"
             MouseEnter="UserControl_MouseEnter"
             MouseLeave="UserControl_MouseLeave"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            Background="#161820"
            BorderBrush="{Binding CardBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="6"
            Padding="8,6"
            Opacity="{Binding CardOpacity}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top row: Location + Kappa badge + Status badge -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Location / Map -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📍 " FontSize="9" Foreground="#7E8494" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Location}" FontSize="10" FontWeight="SemiBold"
                               Foreground="#8E94A5" TextTrimming="CharacterEllipsis" MaxWidth="110"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Badges: Kappa + Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Kappa Badge -->
                    <Border Visibility="{Binding ReqKappa, Converter={StaticResource BoolToVis}}"
                            Background="#332508" BorderBrush="#FFC107" BorderThickness="1"
                            CornerRadius="3" Padding="3,0" Margin="0,0,4,0" ToolTip="Required for Kappa Container">
                        <TextBlock Text="★" FontSize="9" FontWeight="Bold" Foreground="#FFC107" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Status Badge -->
                    <Border Background="{Binding StatusBackgroundBrush}"
                            BorderBrush="{Binding StatusBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3" Padding="4,1">
                        <TextBlock Text="{Binding StatusBadgeText}"
                                   FontSize="8.5" FontWeight="Bold"
                                   Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Middle row: Quest Name -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Name}"
                       FontSize="11.5" FontWeight="Bold"
                       Foreground="#E4E6ED"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       Margin="0,2,0,2"
                       ToolTip="{Binding Name}"/>

            <!-- Bottom row: Level req + Cross-trader badge indicator -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Level requirement -->
                <Border Grid.Column="0"
                        Visibility="{Binding HasLevelReq, Converter={StaticResource BoolToVis}}"
                        Background="#1E202B" BorderBrush="#353948" BorderThickness="1"
                        CornerRadius="3" Padding="3,0" Margin="0,0,4,0">
                    <TextBlock Text="{Binding LevelBadgeText}" FontSize="9" FontWeight="SemiBold"
                               Foreground="#A0A5B5" VerticalAlignment="Center"/>
                </Border>

                <!-- Cross-trader prereqs -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding CrossTraderPrerequisites}"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#211B14" BorderBrush="#664D1A" BorderThickness="1"
                                    CornerRadius="3" Padding="3,0" Margin="2,0,0,0"
                                    ToolTip="{Binding DisplayBadge}" Cursor="Hand"
                                    MouseLeftButtonDown="CrossTraderBadge_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⤾ " FontSize="8" Foreground="#D99B26" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Trader}" FontSize="8.5" FontWeight="SemiBold" Foreground="#D99B26" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
