<UserControl x:Class="TarkovHelper.Pages.CollectorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="{DynamicResource TacticalSurface0Brush}">

    <UserControl.Resources>
        <!-- Inherit FontFamily for all TextBlocks in this page -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>

        <!-- Tactical Hardware Stepper Button Style -->
        <Style x:Key="QuantityButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="{DynamicResource TacticalSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TacticalTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TacticalBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TacticalGoldBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TacticalSurface3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item List Item Template with Inventory Controls -->
        <DataTemplate x:Key="ItemListTemplate">
            <Border x:Name="ItemBorder" Padding="10,8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource TacticalBorderSubtleBrush}"
                    Background="{DynamicResource TacticalSurface2Brush}"
                    CornerRadius="5" Margin="0,0,0,4"
                    Opacity="{Binding ItemOpacity}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <!-- Item Icon in EFT Slot Cell -->
                    <Border Grid.Column="0" Grid.RowSpan="2" Width="48" Height="48"
                            CornerRadius="4" Background="#101216"
                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding IconSource}"
                                   Width="42" Height="42"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Fulfilled checkmark overlay -->
                            <TextBlock Text="&#x2713;" FontSize="{DynamicResource FontSizeXLarge}" FontWeight="Bold"
                                       Foreground="{DynamicResource TacticalSuccessBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,2,0"
                                       Visibility="{Binding FulfilledVisibility}"/>
                        </Grid>
                    </Border>

                    <!-- Item Name -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="12,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextDecorations="{Binding NameTextDecorations}"/>
                            <Border Padding="4,1" CornerRadius="2" Margin="6,0,0,0"
                                    Background="{DynamicResource BadgeFirBgBrush}"
                                    BorderBrush="{DynamicResource BadgeFirBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding FirVisibility}">
                                <TextBlock Text="FIR" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold" Foreground="{DynamicResource BadgeFirFgBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SubtitleName}" FontSize="{DynamicResource FontSizeTiny}"
                                   Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                   Visibility="{Binding SubtitleVisibility}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Owned Quantity Display -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Owned: " FontSize="{DynamicResource FontSizeTiny}"
                                   Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OwnedDisplay}" FontSize="{DynamicResource FontSizeXSmall}" FontWeight="Bold"
                                   FontFamily="{DynamicResource TacticalDisplayFont}"
                                   Foreground="{DynamicResource TacticalSuccessBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick Quantity Buttons Row (Hardware Capsule) -->
                    <Border Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                            Background="{DynamicResource TacticalSurface0Brush}"
                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="4,2" HorizontalAlignment="Left" Margin="12,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FIR:" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold" Foreground="{DynamicResource BadgeFirFgBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="-1" Style="{StaticResource QuantityButtonStyle}"
                                    Click="BtnFirMinus1_Click"/>
                            <TextBlock Text="{Binding OwnedFirQuantity}" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold"
                                       FontFamily="{DynamicResource TacticalDisplayFont}"
                                       Foreground="{DynamicResource TacticalTextPrimaryBrush}" MinWidth="20"
                                       TextAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                            <Button Content="+1" Style="{StaticResource QuantityButtonStyle}"
                                    Click="BtnFirPlus1_Click"/>

                            <TextBlock Text="Non:" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold" Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <Button Content="-1" Style="{StaticResource QuantityButtonStyle}"
                                    Click="BtnNonFirMinus1_Click"/>
                            <TextBlock Text="{Binding OwnedNonFirQuantity}" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold"
                                       FontFamily="{DynamicResource TacticalDisplayFont}"
                                       Foreground="{DynamicResource TacticalTextPrimaryBrush}" MinWidth="20"
                                       TextAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                            <Button Content="+1" Style="{StaticResource QuantityButtonStyle}"
                                    Click="BtnNonFirPlus1_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Quest Count -->
                    <StackPanel Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Quests" FontSize="{DynamicResource FontSizeTiny}"
                                   Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding QuestCountDisplay}" FontSize="{DynamicResource FontSizeSmall}"
                                   FontFamily="{DynamicResource TacticalDisplayFont}"
                                   Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                   HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Total Count -->
                    <StackPanel Grid.Column="4" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Need" FontSize="{DynamicResource FontSizeTiny}"
                                   Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalDisplay}" FontSize="{DynamicResource FontSizeSmall}"
                                   FontFamily="{DynamicResource TacticalDisplayFont}"
                                   Foreground="{DynamicResource TacticalGoldBrush}"
                                   HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource TacticalBorderHighlightBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ListBox Item Container Style -->
        <Style x:Key="ItemListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid x:Name="MainContent" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TacticalSurface1Brush}"
                    BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox x:Name="TxtSearch" Grid.Column="0"
                             TextChanged="TxtSearch_TextChanged"
                             Background="{DynamicResource TacticalSurface2Brush}"
                             BorderBrush="{DynamicResource TacticalBorderMediumBrush}"
                             Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                             Margin="0,0,16,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Tag" Value="Search items..."/>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Filter Toggles -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Include Pre-Quest Checkbox -->
                        <CheckBox x:Name="ChkIncludePreQuest" Content="Include Pre-Quest"
                                  Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,12,0" Cursor="Hand"
                                  Checked="ChkIncludePreQuest_Changed" Unchecked="ChkIncludePreQuest_Changed"
                                  ToolTip="Include items required for Collector's prerequisite quests"/>

                        <!-- Fulfillment Filter -->
                        <ComboBox x:Name="CmbFulfillment" Width="100" Margin="0,0,8,0"
                                  SelectionChanged="CmbFulfillment_SelectionChanged">
                            <ComboBoxItem Content="All Status" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Not Started" Tag="NotStarted"/>
                            <ComboBoxItem Content="In Progress" Tag="InProgress"/>
                            <ComboBoxItem Content="Fulfilled" Tag="Fulfilled"/>
                        </ComboBox>

                        <!-- FIR Filter -->
                        <CheckBox x:Name="ChkFirOnly" Content="FIR Only"
                                  Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,8,0" Cursor="Hand"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                        <!-- Hide Fulfilled -->
                        <CheckBox x:Name="ChkHideFulfilled" Content="Hide Fulfilled"
                                  Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,8,0" Cursor="Hand"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                        <!-- Sort By -->
                        <ComboBox x:Name="CmbSort" Width="110"
                                  SelectionChanged="CmbSort_SelectionChanged">
                            <ComboBoxItem Content="Name" Tag="Name" IsSelected="True"/>
                            <ComboBoxItem Content="Total Count" Tag="Total"/>
                            <ComboBoxItem Content="Quest Count" Tag="Quest"/>
                            <ComboBoxItem Content="Progress" Tag="Progress"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Statistics Bar -->
            <Border Grid.Row="1" Padding="12,6" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtStats" FontSize="{DynamicResource FontSizeXSmall}"
                               Foreground="{DynamicResource TacticalTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="350" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- Item List with Header -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Headers -->
                    <Border Grid.Row="0" Background="{DynamicResource TacticalSurface2Brush}"
                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1,1,1,0"
                            CornerRadius="6,6,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TacticalTextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Item Name" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TacticalTextSecondaryBrush}" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="Quests" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TacticalTextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Total" FontSize="{DynamicResource FontSizeTiny}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TacticalGoldBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Item List -->
                    <Border Grid.Row="1" Background="{DynamicResource TacticalSurface1Brush}"
                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1,0,1,1"
                            CornerRadius="0,0,6,6">
                        <ListBox x:Name="LstItems"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemTemplate="{StaticResource ItemListTemplate}"
                                 ItemContainerStyle="{StaticResource ItemListBoxItem}"
                                 SelectionChanged="LstItems_SelectionChanged"
                                 ScrollViewer.ScrollChanged="LstItems_ScrollChanged"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                <!-- Detail Panel -->
                <Border Grid.Column="2" Background="{DynamicResource TacticalSurface1Brush}"
                        BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16">
                    <Grid>
                        <!-- Empty State -->
                        <TextBlock x:Name="TxtSelectItem"
                                   Text="Select an item to view details"
                                   FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Grid x:Name="DetailPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Item Header (Fixed) -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Item Icon -->
                                <Border Grid.Column="0" Width="56" Height="56"
                                        CornerRadius="6" Background="{DynamicResource TacticalSurface0Brush}"
                                        BorderBrush="{DynamicResource TacticalBorderMediumBrush}" BorderThickness="1">
                                    <Image x:Name="ImgDetailIcon"
                                           Width="48" Height="48"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Item Name -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtDetailName" FontSize="{DynamicResource FontSizeMedium}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TacticalGoldBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtDetailSubtitle" FontSize="{DynamicResource FontSizeXSmall}"
                                               Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- Wiki Button (Fixed) -->
                            <Button x:Name="BtnWiki" Grid.Row="1" Content="Open Wiki" Padding="12,6"
                                    Margin="0,0,0,16" HorizontalAlignment="Left"
                                    Click="BtnWiki_Click"/>

                            <!-- Scrollable Content -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Summary -->
                                    <Border Background="{DynamicResource TacticalSurface2Brush}"
                                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="Quests" FontSize="{DynamicResource FontSizeTiny}"
                                                           Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtDetailQuestCount" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                                           FontFamily="{DynamicResource TacticalDisplayFont}"
                                                           Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="Need" FontSize="{DynamicResource FontSizeTiny}"
                                                           Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtDetailTotalCount" FontSize="{DynamicResource FontSizeLarge}" FontWeight="Bold"
                                                           FontFamily="{DynamicResource TacticalDisplayFont}"
                                                           Foreground="{DynamicResource TacticalGoldBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Inventory Input Section -->
                                    <TextBlock Text="Your Inventory" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <Border Background="{DynamicResource TacticalSurface2Brush}"
                                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                        <StackPanel>
                                            <!-- FIR Quantity Row -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Padding="4,2" CornerRadius="2" Margin="0,0,6,0"
                                                            Background="{DynamicResource BadgeFirBgBrush}"
                                                            BorderBrush="{DynamicResource BadgeFirBorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="FIR" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold" Foreground="{DynamicResource BadgeFirFgBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="Qty:" FontSize="{DynamicResource FontSizeXSmall}"
                                                               Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="-5" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailFirMinus5_Click"/>
                                                    <Button Content="-1" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailFirMinus1_Click"/>
                                                    <Border Background="{DynamicResource TacticalSurface0Brush}"
                                                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="4,4" Margin="4,0"
                                                            MinWidth="40">
                                                        <TextBox x:Name="TxtDetailOwnedFir" Text="0"
                                                                 FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold"
                                                                 FontFamily="{DynamicResource TacticalDisplayFont}"
                                                                 Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Center"
                                                                 TextAlignment="Center"
                                                                 MinWidth="30"
                                                                 VerticalContentAlignment="Center"
                                                                 PreviewTextInput="TxtDetailOwned_PreviewTextInput"
                                                                 LostFocus="TxtDetailOwnedFir_LostFocus"
                                                                 KeyDown="TxtDetailOwnedFir_KeyDown"/>
                                                    </Border>
                                                    <Button Content="+1" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailFirPlus1_Click"/>
                                                    <Button Content="+5" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailFirPlus5_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Non-FIR Quantity Row -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="Non-FIR:" FontSize="{DynamicResource FontSizeXSmall}"
                                                           Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="-5" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailNonFirMinus5_Click"/>
                                                    <Button Content="-1" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailNonFirMinus1_Click"/>
                                                    <Border Background="{DynamicResource TacticalSurface0Brush}"
                                                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="4,4" Margin="4,0"
                                                            MinWidth="40">
                                                        <TextBox x:Name="TxtDetailOwnedNonFir" Text="0"
                                                                 FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold"
                                                                 FontFamily="{DynamicResource TacticalDisplayFont}"
                                                                 Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 HorizontalAlignment="Center"
                                                                 TextAlignment="Center"
                                                                 MinWidth="30"
                                                                 VerticalContentAlignment="Center"
                                                                 PreviewTextInput="TxtDetailOwned_PreviewTextInput"
                                                                 LostFocus="TxtDetailOwnedNonFir_LostFocus"
                                                                 KeyDown="TxtDetailOwnedNonFir_KeyDown"/>
                                                    </Border>
                                                    <Button Content="+1" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailNonFirPlus1_Click"/>
                                                    <Button Content="+5" Style="{StaticResource QuantityButtonStyle}"
                                                            Click="BtnDetailNonFirPlus5_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Fulfillment Status -->
                                            <Border Margin="0,12,0,0" Padding="8" CornerRadius="4"
                                                    Background="{DynamicResource TacticalSurface0Brush}"
                                                    BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Progress" FontSize="{DynamicResource FontSizeTiny}"
                                                                   Foreground="{DynamicResource TacticalTextSecondaryBrush}"/>
                                                        <ProgressBar x:Name="DetailProgressBar"
                                                                     Height="6" Margin="0,4,8,0"
                                                                     Minimum="0" Maximum="100" Value="0"
                                                                     Foreground="{DynamicResource TacticalGoldBrush}"
                                                                     Background="{DynamicResource TacticalSurface1Brush}" BorderThickness="0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtDetailFulfillmentStatus"
                                                                   Text="Not Started"
                                                                   FontSize="{DynamicResource FontSizeXSmall}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quest Requirements Section -->
                                    <StackPanel x:Name="QuestSection">
                                        <TextBlock Text="Required for Quests" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                                                   Margin="0,0,0,8"/>
                                        <Border Background="{DynamicResource TacticalSurface2Brush}"
                                                BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                            <ItemsControl x:Name="QuestRequirementsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="QuestItemBorder" Padding="6" Margin="0,2"
                                                                Background="{DynamicResource TacticalSurface1Brush}"
                                                                BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                                                CornerRadius="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" Margin="4,0"
                                                                            Cursor="Hand"
                                                                            MouseLeftButtonDown="QuestName_Click">
                                                                    <TextBlock x:Name="QuestNameText"
                                                                               Text="{Binding QuestName}"
                                                                               FontSize="{DynamicResource FontSizeXSmall}" TextWrapping="Wrap">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                                <Setter Property="Foreground" Value="{DynamicResource TacticalTextPrimaryBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource TacticalGoldBrush}"/>
                                                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding TraderName}"
                                                                               Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                                                                               FontSize="{DynamicResource FontSizeTiny}"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            VerticalAlignment="Center" Margin="8,0,4,0">
                                                                    <TextBlock Text="{Binding AmountDisplay}"
                                                                               Foreground="{DynamicResource TacticalGoldBrush}"
                                                                               FontFamily="{DynamicResource TacticalDisplayFont}"
                                                                               FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>
                                                                    <Border Padding="4,2" CornerRadius="2" Margin="6,0,0,0"
                                                                            Background="{DynamicResource BadgeFirBgBrush}"
                                                                            BorderBrush="{DynamicResource BadgeFirBorderBrush}" BorderThickness="1"
                                                                            Visibility="{Binding FirVisibility}">
                                                                        <TextBlock Text="FIR" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold" Foreground="{DynamicResource BadgeFirFgBrush}"/>
                                                                    </Border>
                                                                    <!-- Kappa Required Badge -->
                                                                    <Border Padding="4,2" CornerRadius="2" Margin="4,0,0,0"
                                                                            Background="{DynamicResource BadgeKappaBgBrush}"
                                                                            BorderBrush="{DynamicResource BadgeKappaBorderBrush}" BorderThickness="1"
                                                                            Visibility="{Binding KappaVisibility}">
                                                                        <TextBlock Text="Kappa" FontSize="{DynamicResource FontSizeTiny}" FontWeight="Bold" Foreground="{DynamicResource BadgeKappaFgBrush}"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <Button Grid.Column="2" Content="Wiki" Padding="6,2"
                                                                        FontSize="{DynamicResource FontSizeTiny}" MinWidth="40" Margin="4,0,0,0"
                                                                        Click="BtnQuestWiki_Click"
                                                                        Tag="{Binding}"
                                                                        Visibility="{Binding WikiButtonVisibility}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Visible" Background="{DynamicResource TacticalSurface0Brush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Height="4" Width="200" IsIndeterminate="True"
                             Foreground="{DynamicResource TacticalGoldBrush}"
                             Background="{DynamicResource TacticalSurface2Brush}" BorderThickness="0"/>
                <TextBlock x:Name="LoadingStatusText"
                           Text="Loading Collector items..."
                           FontSize="{DynamicResource FontSizeSmall}" Margin="0,16,0,0"
                           Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
