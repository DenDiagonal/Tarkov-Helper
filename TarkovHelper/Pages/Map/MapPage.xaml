<UserControl x:Class="TarkovHelper.Pages.Map.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:TarkovHelper.Pages.Map"
             xmlns:mapvm="clr-namespace:TarkovHelper.Pages.Map.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             ToolTipService.ShowDuration="30000"
             ToolTipService.InitialShowDelay="300"
             ToolTipService.BetweenShowDelay="100"
             Background="{DynamicResource TacticalSurface0Brush}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <!-- Tactical Palette Surfaces & Borders -->
        <SolidColorBrush x:Key="TacticalSurface0Brush" Color="#0D0E11"/>
        <SolidColorBrush x:Key="TacticalSurface1Brush" Color="#131519"/>
        <SolidColorBrush x:Key="TacticalSurface2Brush" Color="#1A1D23"/>
        <SolidColorBrush x:Key="TacticalSurface3Brush" Color="#21252D"/>
        <SolidColorBrush x:Key="TacticalSurface4Brush" Color="#292E38"/>
        <SolidColorBrush x:Key="TacticalBorderSubtleBrush" Color="#242832"/>
        <SolidColorBrush x:Key="TacticalBorderMediumBrush" Color="#323846"/>
        <SolidColorBrush x:Key="TacticalBorderHighlightBrush" Color="#4A5368"/>
        <SolidColorBrush x:Key="TacticalGoldBrush" Color="#C5A84A"/>
        <SolidColorBrush x:Key="TacticalGoldHoverBrush" Color="#D8BB5C"/>
        <!-- TarkovTracker Map Control Pill Toggle Style -->
        <Style x:Key="MapPillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1D23"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#323846"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242014"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C5A84A"/>
                                <Setter Property="Foreground" Value="#D8BB5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <!-- Reusable Compact Action Button Style for Map controls -->
        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1D23"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#242832"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252A34"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A5368"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E3440"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TacticalGoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: 컨트롤 영역 (상단 컨트롤 바) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: 맵 선택 Pills 바 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: 상태 표시 바 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: 메인 콘텐츠 영역 (맵 뷰어 + 드로어) -->
            <RowDefinition Height="*"/>
            <!-- Row 4: 활성 퀘스트 요구 아이템 및 열쇠 단일 스트립 바 (맵 바로 아래) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 컨트롤 바 -->
        <Border Grid.Row="0" Background="{StaticResource TacticalSurface1Brush}" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 타이틀 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPageTitle" Text="Map Position Tracker" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- 맵 선택 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtMapLabel" Text="Map:" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbMapSelect" Width="160" SelectionChanged="CmbMapSelect_SelectionChanged"/>

                    <!-- 층 선택 (다층 맵에서만 표시) -->
                    <TextBlock x:Name="TxtFloorLabel" Text="Floor:" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,8,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="CmbFloorSelect" Width="120" SelectionChanged="CmbFloorSelect_SelectionChanged"
                              Visibility="Collapsed"/>
                </StackPanel>

                <!-- 버튼들 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                    <CheckBox x:Name="ChkShowQuestMarkers" Content="Quest Markers"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              IsChecked="True"
                              Checked="ChkShowQuestMarkers_Changed"
                              Unchecked="ChkShowQuestMarkers_Changed"/>
                    <CheckBox x:Name="ChkShowExtractMarkers" Content="Extracts"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              IsChecked="True"
                              Checked="ChkShowExtractMarkers_Changed"
                              Unchecked="ChkShowExtractMarkers_Changed"/>
                    <CheckBox x:Name="ChkFixedView" Content="Fixed View"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,16,0"
                              Checked="ChkFixedView_Changed"
                              Unchecked="ChkFixedView_Changed"/>
                    <Button x:Name="BtnClearTrail" Content="Clear Trail" Padding="12,6"
                            Margin="0,0,8,0" Click="BtnClearTrail_Click"/>
                    <Button x:Name="BtnFullScreen" Content="Full Screen" Padding="12,6"
                            Margin="0,0,8,0" Click="BtnFullScreen_Click"/>
                    <Button x:Name="BtnOpenRelocationManager" Content="📍 Reubicar Objetivos" Padding="12,6" Visibility="Collapsed"
                            Margin="0,0,8,0" ToolTip="Abrir el Gestor de Reubicación de Objetivos e Historial"
                            Click="BtnOpenRelocationManager_Click"/>
                    <Button x:Name="BtnSettings" Content="Settings" Padding="12,6"
                            Click="BtnSettings_Click"/>
                </StackPanel>

                <!-- 시작/중지 버튼 -->
                <Button x:Name="BtnToggleTracking" Grid.Column="3" Content="Start Tracking"
                        Padding="16,6" MinWidth="140" Click="BtnToggleTracking_Click"/>
            </Grid>
        </Border>

        <!-- Row 1: 맵 선택 Pills 바 -->
        <Border Grid.Row="1" Background="{StaticResource TacticalSurface0Brush}" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 수평 맵 선택 Pills -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="MapSelectorPillsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="MapPill_Click" Tag="{Binding MapKey}" Margin="0,0,8,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#131519"/>
                                            <Setter Property="BorderBrush" Value="#242832"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Foreground" Value="#8F96A3"/>
                                            <Setter Property="Padding" Value="12,5"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A5368"/>
                                                                <Setter TargetName="bd" Property="Background" Value="#1A1D23"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#242014"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource TacticalGoldBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TacticalGoldBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="#0D0E11" BorderBrush="#242832" BorderThickness="1" CornerRadius="3" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveTaskCount}" FontSize="10" FontWeight="Bold" FontFamily="{DynamicResource TacticalDisplayFont}" Foreground="#8F96A3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 층 선택기 (다층 맵인 경우 우측에 표시) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="TxtPillFloorLabel" Text="Floor:" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="CmbPillFloorSelect" Width="110" Height="26" SelectionChanged="CmbPillFloorSelect_SelectionChanged"
                              Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 상태 표시 바 -->
        <Border Grid.Row="2" Background="{StaticResource TacticalSurface1Brush}" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 현재 좌표 정보 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10"
                             Fill="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="Waiting"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 좌표 표시 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock x:Name="TxtPositionLabel" Text="Position:" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCoordinates" Text="--" FontFamily="{DynamicResource TacticalMonoFont}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 마지막 업데이트 시간 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock x:Name="TxtLastUpdateLabel" Text="Last Update:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtLastUpdateTime" Text="--"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 메인 콘텐츠 영역 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- 퀘스트 상세 Drawer (왼쪽) -->
                <ColumnDefinition x:Name="QuestDrawerColumn" Width="0" MinWidth="0" MaxWidth="0"/>
                <ColumnDefinition Width="0"/>
                <!-- 맵 뷰어 (중앙) -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- 커스텀 마커 목록 (오른쪽) -->
                <ColumnDefinition x:Name="MarkerListColumn" Width="Auto" MinWidth="0"/>
                <ColumnDefinition x:Name="SettingsColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 맵 뷰어 -->
            <Border Grid.Column="2" Background="{StaticResource TacticalSurface0Brush}"
                    BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="0,0,0,0"
                    ClipToBounds="True">
                <Grid x:Name="MapViewerGrid"
                      Background="Transparent"
                      MouseLeftButtonDown="MapViewer_MouseLeftButtonDown"
                      MouseLeftButtonUp="MapViewer_MouseLeftButtonUp"
                      MouseMove="MapViewer_MouseMove"
                      MouseWheel="MapViewer_MouseWheel"
                      PreviewMouseRightButtonDown="MapViewer_PreviewMouseRightButtonDown">
                    <Grid.ContextMenu>
                        <ContextMenu x:Name="MapContextMenu">
                            <MenuItem x:Name="MenuAddCustomMarker" Header="Add Custom Marker" Click="MenuAddCustomMarker_Click"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <!-- Top Placement Mode Banner Overlay -->
                    <Border x:Name="PlacementModeBanner"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,12,0,0" Panel.ZIndex="200"
                            Background="#F018181C" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5"
                            CornerRadius="6" Padding="16,8"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.7" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎯 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlacementBanner"
                                       Text="Modo de asignación: Haz clic en el mapa para ubicar el objetivo: "
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlacementTargetName"
                                       Text=""
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" FontWeight="Bold"
                                       Margin="4,0,16,0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnCancelPlacement"
                                    Content="Cancelar"
                                    Padding="12,4"
                                    Background="#33FF5252"
                                    Foreground="#FFFF5252"
                                    BorderBrush="#FFFF5252"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    FontWeight="SemiBold"
                                    Click="BtnCancelPlacement_Click"/>
                        </StackPanel>
                    </Border>
                    <!-- 플로팅 멀티 레이어 층 선택기 (다층 맵: Factory, Reserve, The Lab 등) - Permanently Collapsed, superseded by DiscreetFloorControl -->
                    <Border x:Name="OverlayFloorSelectorPanel"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="16,12,0,0" Panel.ZIndex="110"
                            Background="#E6131519" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,4"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Floor:" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="11.5"/>
                            <ComboBox x:Name="CmbOverlayFloorSelect" Width="110" Height="24"
                                      SelectionChanged="CmbOverlayFloorSelect_SelectionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- TarkovTracker Style Map Controls (Top Right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,16,0" Panel.ZIndex="100"
                            Background="#E6131519" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="6,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- PMC Extracts Pill Button -->
                            <ToggleButton x:Name="BtnTogglePmcExtracts" IsChecked="True"
                                          Click="BtnTogglePmcExtracts_Click"
                                          Height="26" Padding="8,0"
                                          Style="{StaticResource MapPillToggleStyle}"
                                          ToolTip="Toggle PMC Extractions">
                                <TextBlock Text="PMC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- Scav Extracts Pill Button -->
                            <ToggleButton x:Name="BtnToggleScavExtracts" IsChecked="True"
                                          Click="BtnToggleScavExtracts_Click"
                                          Height="26" Padding="8,0" Margin="4,0,0,0"
                                          Style="{StaticResource MapPillToggleStyle}"
                                          ToolTip="Toggle Scav Extractions">
                                <TextBlock Text="Scav" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- Spawns Pill Button -->
                            <ToggleButton x:Name="BtnToggleSpawns" IsChecked="True"
                                          Click="BtnToggleSpawns_Click"
                                          Height="26" Padding="8,0" Margin="4,0,0,0"
                                          Style="{StaticResource MapPillToggleStyle}"
                                          ToolTip="Toggle Spawns">
                                <TextBlock Text="Spawns" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- Separator -->
                            <Rectangle Width="1" Height="14" Fill="#3E3E4C" Margin="6,0,6,0" VerticalAlignment="Center"/>

                            <!-- Settings Cog Button -->
                            <ToggleButton x:Name="BtnMapSettingsCog"
                                          Width="26" Height="26" Padding="0"
                                          Click="BtnMapSettingsCog_Click"
                                          Style="{StaticResource MapPillToggleStyle}"
                                          ToolTip="Map Marker Settings">
                                <TextBlock Text="⚙" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Map Settings Flyout Popup -->
                    <Popup x:Name="MapSettingsPopup" PlacementTarget="{Binding ElementName=BtnMapSettingsCog}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="#F0181820" BorderBrush="#3E3E4C" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,6,0,0" MinWidth="180">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="MAP MARKERS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <!-- Sniper Scavs -->
                                <CheckBox x:Name="ChkSettingSniperScavs" Content="Sniper Scavs"
                                          IsChecked="True" Margin="0,3"
                                          Click="MapSettingItem_Changed"/>

                                <!-- Rogues -->
                                <CheckBox x:Name="ChkSettingRogues" Content="Rogues"
                                          IsChecked="True" Margin="0,3"
                                          Click="MapSettingItem_Changed"/>

                                <!-- Cultists -->
                                <CheckBox x:Name="ChkSettingCultists" Content="Cultists"
                                          IsChecked="True" Margin="0,3"
                                          Click="MapSettingItem_Changed"/>

                                <!-- Levers -->
                                <CheckBox x:Name="ChkSettingLevers" Content="Levers"
                                          IsChecked="True" Margin="0,3"
                                          Click="MapSettingItem_Changed"/>

                                <!-- Bosses -->
                                <CheckBox x:Name="ChkSettingBosses" Content="Bosses"
                                          IsChecked="True" Margin="0,3"
                                          Click="MapSettingItem_Changed"/>

                                <!-- Task Titles on Map Toggle -->
                                <CheckBox x:Name="ChkSettingTaskTitles" Content="Mostrar nombres de misiones"
                                          IsChecked="False" Margin="0,3"
                                          Click="ChkSettingTaskTitles_Click"/>

                                <Separator Background="#3E3E4C" Margin="0,8,0,8"/>

                                <!-- Minimap Toggle -->
                                <Button x:Name="BtnMinimap" Content="MiniMap Window" Padding="8,4"
                                        Click="BtnMinimap_Click"
                                        Style="{StaticResource HeaderActionButtonStyle}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Bottom-right Controls: Compact Floor Selector stacked on top of Zoom & View Controls -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,16" Panel.ZIndex="100"
                                Orientation="Vertical">

                        <!-- Discreet Floor Selector (Above Zoom controls, visible only on multi-floor maps) -->
                        <Border x:Name="DiscreetFloorControl"
                                Background="#E6131519" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="3" Margin="0,0,0,8"
                                Visibility="Collapsed" HorizontalAlignment="Center">
                            <StackPanel Orientation="Vertical" Width="28">
                                <!-- Floor Up (+) -->
                                <Button x:Name="BtnFloorUp" Content="+" Width="28" Height="26" Padding="0"
                                        FontSize="14" FontWeight="Bold" Click="BtnFloorUp_Click"
                                        Style="{StaticResource HeaderActionButtonStyle}" Margin="0,0,0,2"
                                        ToolTip="Subir de planta"/>

                                <!-- Current Floor Indicator (B, 1, 2, 3...) -->
                                <Border Height="24" Background="#23232C" CornerRadius="4" Margin="0,0,0,2"
                                        ToolTip="{Binding ElementName=TxtFloorCode, Path=Tag}">
                                    <TextBlock x:Name="TxtFloorCode" Text="1"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource TacticalGoldBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Floor Down (-) -->
                                <Button x:Name="BtnFloorDown" Content="−" Width="28" Height="26" Padding="0"
                                        FontSize="14" FontWeight="Bold" Click="BtnFloorDown_Click"
                                        Style="{StaticResource HeaderActionButtonStyle}"
                                        ToolTip="Bajar de planta"/>
                            </StackPanel>
                        </Border>

                        <!-- Vertical Zoom & View Controls (TarkovTracker style) -->
                        <Border Background="#E6131519" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="3">
                            <StackPanel Orientation="Vertical">
                                <Button x:Name="BtnZoomIn" Content="+" Width="28" Height="28" Padding="0"
                                        FontSize="14" FontWeight="Bold" Click="BtnZoomIn_Click"
                                        Style="{StaticResource HeaderActionButtonStyle}" Margin="0,0,0,2"
                                        ToolTip="Zoom In"/>
                                <Button x:Name="BtnZoomOut" Content="−" Width="28" Height="28" Padding="0"
                                        FontSize="14" FontWeight="Bold" Click="BtnZoomOut_Click"
                                        Style="{StaticResource HeaderActionButtonStyle}" Margin="0,0,0,2"
                                        ToolTip="Zoom Out"/>
                                <Button x:Name="BtnResetView" Content="⟳" Width="28" Height="28" Padding="0"
                                        FontSize="14" FontWeight="Bold" Click="BtnResetView_Click"
                                        Style="{StaticResource HeaderActionButtonStyle}" Margin="0,0,0,2"
                                        ToolTip="Reset View"/>
                                <Button x:Name="BtnToggleFullScreen" Content="⛶" Width="28" Height="28" Padding="0"
                                        FontSize="12" Click="BtnToggleFullScreen_Click"
                                        Style="{StaticResource HeaderActionButtonStyle}"
                                        ToolTip="Toggle Full Screen"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 맵 캔버스 (테스트: Transform 비활성화) -->
                    <Canvas x:Name="MapCanvas" Background="Transparent"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Cursor="Arrow">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="MapTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                            <!-- 맵 이미지 (PNG/JPG) -->
                            <Image x:Name="MapImage" Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>

                            <!-- 맵 이미지 (SVG) - TarkovDBEditor와 동일하게 Stretch="None" 사용 -->
                            <svgc:SvgViewbox x:Name="MapSvg" Stretch="None" Visibility="Collapsed"/>

                            <!-- Map Markers 컨테이너 (PMC Spawn, Sniper Scav, Rogue, Cultist, Lever) -->
                            <Canvas x:Name="MapMarkersContainer"/>

                            <!-- 탈출구 마커 컨테이너 -->
                            <Canvas x:Name="ExtractMarkersContainer"/>

                            <!-- 퀘스트 목표 마커 컨테이너 -->
                            <Canvas x:Name="QuestMarkersContainer"/>

                            <!-- 커스텀 마커 컨테이너 -->
                            <Canvas x:Name="CustomMarkersContainer"/>

                            <!-- 이동 경로 (Polyline) -->
                            <Polyline x:Name="TrailPath" Stroke="#80FF5722"
                                      StrokeThickness="2" StrokeLineJoin="Round"/>

                            <!-- 플레이어 마커 (방향 표시 - 화살표 + 원) -->
                            <Canvas x:Name="PlayerMarker" Visibility="Collapsed">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="MarkerScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="MarkerTranslation" X="0" Y="0"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <!-- 외곽 글로우 효과 -->
                                <Ellipse Width="28" Height="28" Canvas.Left="-14" Canvas.Top="-14"
                                         Fill="#40FF5722"/>

                                <!-- 중심 원 -->
                                <Ellipse Width="16" Height="16" Canvas.Left="-8" Canvas.Top="-8"
                                         Fill="#FFFF5722" Stroke="#FFFFFFFF" StrokeThickness="2"/>

                                <!-- 방향 화살표 -->
                                <Path x:Name="DirectionArrow" Fill="#FFFF5722" Stroke="#FFFFFFFF" StrokeThickness="1">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,-24" IsClosed="True">
                                                <LineSegment Point="6,-12"/>
                                                <LineSegment Point="2,-12"/>
                                                <LineSegment Point="2,-8"/>
                                                <LineSegment Point="-2,-8"/>
                                                <LineSegment Point="-2,-12"/>
                                                <LineSegment Point="-6,-12"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="MarkerRotation" Angle="0" CenterX="0" CenterY="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>

                            <!-- 방향 표시가 없을 때 사용하는 원형 마커 -->
                            <Canvas x:Name="PlayerDot" Visibility="Collapsed">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1"/>
                                        <TranslateTransform x:Name="DotTranslation" X="0" Y="0"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <!-- 외곽 글로우 효과 -->
                                <Ellipse Width="28" Height="28" Canvas.Left="-14" Canvas.Top="-14"
                                         Fill="#40FF5722"/>

                                <!-- 중심 원 -->
                                <Ellipse Width="16" Height="16" Canvas.Left="-8" Canvas.Top="-8"
                                         Fill="#FFFF5722" Stroke="#FFFFFFFF" StrokeThickness="2"/>
                            </Canvas>
                        </Canvas>

                    <!-- 맵 없음 안내 -->
                    <StackPanel x:Name="NoMapPanel" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Visible">
                        <TextBlock x:Name="TxtNoMapImage" Text="No map image available" FontSize="18"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtAddMapImageHint" Text="Add image to Assets/Maps/ folder" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtSetImagePathHint" Text="Or specify path in Settings" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Map Markers 오버레이 패널 (우측 하단) -->
                    <Border x:Name="MapMarkersOverlay" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16" Panel.ZIndex="100"
                            Background="#E0202020"
                            CornerRadius="6" Padding="10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <!-- 헤더 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtMapMarkersTitle" Text="Map Markers"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Button x:Name="BtnToggleMapMarkersPanel" Content="▼"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="10" Padding="4,0" Margin="8,0,0,0"
                                        Click="BtnToggleMapMarkersPanel_Click"
                                        VerticalAlignment="Center" Cursor="Hand"/>
                            </StackPanel>

                                                        <!-- 마커 토글 목록 -->
                            <StackPanel x:Name="MapMarkersContent">
                                <!-- Extracts: PMC & Scav -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowPmcExtracts" IsChecked="True"
                                              Checked="ChkExtractFilter_Changed" Unchecked="ChkExtractFilter_Changed"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="🚪" FontSize="11" Margin="4,0,6,0" VerticalAlignment="Center" Foreground="#4CAF50"/>
                                    <TextBlock x:Name="TxtPmcExtractsLabel" Text="PMC Extracts" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowScavExtracts" IsChecked="True"
                                              Checked="ChkExtractFilter_Changed" Unchecked="ChkExtractFilter_Changed"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="🚪" FontSize="11" Margin="4,0,6,0" VerticalAlignment="Center" Foreground="#FF9800"/>
                                    <TextBlock x:Name="TxtScavExtractsLabel" Text="Scav Extracts" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- PMC Spawn -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowPmcSpawns" IsChecked="True"
                                              Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"
                                              VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox x:Name="IconPmcSpawn" Width="18" Height="18"
                                                     Margin="4,0,6,0" Stretch="Uniform"/>
                                    <TextBlock Text="PMC Spawns" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Sniper Scav -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowSniperScavs" IsChecked="True"
                                              Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"
                                              VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox x:Name="IconSniperScav" Width="18" Height="18"
                                                     Margin="4,0,6,0" Stretch="Uniform"/>
                                    <TextBlock Text="Sniper Scavs" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Rogue -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowRogues" IsChecked="True"
                                              Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"
                                              VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox x:Name="IconRogue" Width="18" Height="18"
                                                     Margin="4,0,6,0" Stretch="Uniform"/>
                                    <TextBlock Text="Rogues" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Cultist -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowCultists" IsChecked="True"
                                              Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"
                                              VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox x:Name="IconCultist" Width="18" Height="18"
                                                     Margin="4,0,6,0" Stretch="Uniform"/>
                                    <TextBlock Text="Cultists" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Lever -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowLeversMarker" IsChecked="True"
                                              Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"
                                              VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox x:Name="IconLever" Width="18" Height="18"
                                                     Margin="4,0,6,0" Stretch="Uniform"/>
                                    <TextBlock Text="Levers" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Boss -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="ChkShowBosses" IsChecked="True"
                                              Checked="ChkMapMarker_Changed" Unchecked="ChkMapMarker_Changed"
                                              VerticalAlignment="Center"/>
                                    <svgc:SvgViewbox x:Name="IconBoss" Width="18" Height="18"
                                                     Margin="4,0,6,0" Stretch="Uniform"/>
                                    <TextBlock Text="Bosses" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 설정 패널 (토글 가능) -->
            <Border x:Name="SettingsPanel" Grid.Column="5"
                    Background="{StaticResource TacticalSurface1Brush}"
                    BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- 설정 헤더 -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock x:Name="TxtSettingsTitle" Text="Settings" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Content="✕" HorizontalAlignment="Right" Padding="8,4"
                                    Click="BtnCloseSettings_Click" Background="Transparent"
                                    BorderThickness="0"/>
                        </Grid>

                        <!-- 스크린샷 폴더 설정 -->
                        <TextBlock x:Name="TxtScreenshotFolderLabel" Text="Screenshot Folder" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox x:Name="TxtScreenshotFolder" IsReadOnly="True" Margin="0,0,0,8"
                                 TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button x:Name="BtnAutoDetect" Content="Auto Detect" Padding="12,6"
                                    Margin="0,0,8,0" Click="BtnAutoDetect_Click"/>
                            <Button x:Name="BtnBrowseFolder" Content="Browse" Padding="12,6"
                                    Click="BtnBrowseFolder_Click"/>
                        </StackPanel>

                        <!-- 마커 설정 -->
                        <TextBlock x:Name="TxtMarkerSettingsLabel" Text="Marker Settings" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- 완료된 퀘스트 목표 숨기기 -->
                        <CheckBox x:Name="ChkHideCompletedObjectives" Content="Hide completed objectives"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,12" IsChecked="False"
                                  Checked="ChkHideCompletedObjectives_Changed"
                                  Unchecked="ChkHideCompletedObjectives_Changed"/>

                        <!-- 퀘스트 마커 스타일 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtQuestStyleLabel" Text="Quest style:" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="90"/>
                            <ComboBox x:Name="CmbQuestMarkerStyle" Width="160"
                                      SelectionChanged="CmbQuestMarkerStyle_SelectionChanged">
                                <ComboBoxItem x:Name="CmbStyleIconOnly" Content="Icon only" Tag="Default"/>
                                <ComboBoxItem x:Name="CmbStyleGreenCircle" Content="Green circle" Tag="GreenCircle"/>
                                <ComboBoxItem x:Name="CmbStyleIconWithName" Content="Icon + Name" Tag="DefaultWithName"/>
                                <ComboBoxItem x:Name="CmbStyleCircleWithName" Content="Circle + Name" Tag="GreenCircleWithName"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 퀘스트명 텍스트 크기 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtQuestNameSizeLabel" Text="Quest name:" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="90"/>
                            <Slider x:Name="SliderQuestNameTextSize" Width="120" Minimum="1" Maximum="100"
                                    Value="20" ValueChanged="SliderQuestNameTextSize_ValueChanged"/>
                            <TextBlock x:Name="TxtQuestNameTextSize" Text="20" Width="30"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- 퀘스트 마커 크기 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="TxtQuestMarkerSizeLabel" Text="Quest marker:" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="90"/>
                            <Slider x:Name="SliderMarkerSize" Width="120" Minimum="1" Maximum="100"
                                    Value="18" ValueChanged="SliderMarkerSize_ValueChanged"/>
                            <TextBlock x:Name="TxtMarkerSize" Text="18" Width="30"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- 플레이어 위치 마커 크기 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <TextBlock x:Name="TxtPlayerMarkerSizeLabel" Text="Player marker:" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="90"/>
                            <Slider x:Name="SliderPlayerMarkerSize" Width="120" Minimum="1" Maximum="100"
                                    Value="18" ValueChanged="SliderPlayerMarkerSize_ValueChanged"/>
                            <TextBlock x:Name="TxtPlayerMarkerSize" Text="18" Width="30"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>


                        <!-- 탈출구 설정 -->
                        <TextBlock x:Name="TxtExtractSettingsLabel" Text="Extract Settings" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- Obsolete extract checkboxes moved to Map Markers overlay -->

                        <CheckBox x:Name="ChkShowTransitExtracts" Content="Transit Extracts"
                                  Foreground="#2196F3" FontWeight="SemiBold"
                                  Margin="0,0,0,12" IsChecked="True"
                                  Checked="ChkExtractFilter_Changed"
                                  Unchecked="ChkExtractFilter_Changed"/>

                        <!-- 탈출구 이름 텍스트 크기 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <TextBlock x:Name="TxtExtractNameSizeLabel" Text="Name size:" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Width="100"/>
                            <Slider x:Name="SliderExtractTextSize" Width="120" Minimum="8" Maximum="24"
                                    Value="16" ValueChanged="SliderExtractTextSize_ValueChanged"/>
                            <TextBlock x:Name="TxtExtractTextSize" Text="16" Width="30"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- 기초 마커 색상 설정 -->
                        <TextBlock x:Name="TxtMarkerColorsLabel" Text="Marker Colors" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        
                        <!-- Visit 색상 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="ColorVisit" Width="24" Height="24" Background="#4CAF50"
                                    CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="visit"/>
                            <TextBlock x:Name="TxtColorVisit" Text="Visit" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <!-- Mark 색상 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="ColorMark" Width="24" Height="24" Background="#FF9800"
                                    CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="mark"/>
                            <TextBlock x:Name="TxtColorMark" Text="Mark" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <!-- Plant 색상 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="ColorPlant" Width="24" Height="24" Background="#9C27B0"
                                    CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="plantItem"/>
                            <TextBlock x:Name="TxtColorPlant" Text="Plant" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <!-- Extract 색상 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="ColorExtract" Width="24" Height="24" Background="#2196F3"
                                    CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="extract"/>
                            <TextBlock x:Name="TxtColorExtract" Text="Extract" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <!-- Find 색상 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="ColorFind" Width="24" Height="24" Background="#FFEB3B"
                                    CornerRadius="4" Cursor="Hand" MouseLeftButtonDown="MarkerColor_Click" Tag="findItem"/>
                            <TextBlock x:Name="TxtColorFind" Text="Find" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                        </StackPanel>
                        <!-- 기본값 복원 버튼 -->
                        <Button x:Name="BtnResetColors" Content="Reset Colors" FontSize="11" Padding="8,4"
                                Margin="0,8,0,0" Click="BtnResetColors_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 맵 뷰어 사이 리사이즈 핸들 (오른쪽) -->
            <Grid Grid.Column="3">
                <GridSplitter Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}" ShowsPreview="True"/>
            </Grid>

            <!-- 커스텀 마커 목록 사이드바 (오른쪽) -->
            <Border x:Name="MarkerListPanel" Grid.Column="4" Visibility="Collapsed" 
                    Background="{StaticResource TacticalSurface1Brush}"
                    BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 사이드바 최소화 핸들 (좌측 경계) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- 마커 목록 콘텐츠 -->
                        <ColumnDefinition x:Name="MarkerListContentColumn" Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- 최소화 핸들 버튼 -->
                    <Button x:Name="BtnToggleCustomMarkersPanel" Grid.Column="0" 
                            Width="16" VerticalAlignment="Stretch" Padding="0"
                            Background="{StaticResource BackgroundLightBrush}" BorderThickness="0,0,1,0"
                            BorderBrush="{StaticResource BorderBrush}" Click="BtnToggleCustomMarkersPanel_Click"
                            Cursor="Hand" ToolTip="Toggle list">
                        <TextBlock x:Name="TxtToggleIcon" Text="◀" FontSize="10" 
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Grid Grid.Column="1" x:Name="MarkerListContentGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}" Padding="12,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="📍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Custom Markers" FontSize="14" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 마커 투명도 조절 (항상 노출되도록 이동) -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtMarkerOpacityLabel" Text="Opacity:" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" VerticalAlignment="Center" Width="65"/>
                                    <Slider x:Name="SliderMarkerOpacity" Width="130" Minimum="0" Maximum="100"
                                            Value="100" ValueChanged="SliderMarkerOpacity_ValueChanged"/>
                                    <TextBlock x:Name="TxtMarkerOpacity" Text="100%" Width="40" FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ListView x:Name="LstCustomMarkers" Grid.Row="1"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="LstCustomMarkers_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" 
                                                        Padding="8,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#2D4A63"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- 색상 표시기 -->
                                        <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,8,0"
                                                 Stroke="White" StrokeThickness="0.5">
                                            <Ellipse.Fill>
                                                <Binding Path="Color">
                                                    <Binding.FallbackValue>
                                                        <SolidColorBrush Color="Gold"/>
                                                    </Binding.FallbackValue>
                                                </Binding>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <!-- 마커 정보 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FloorId}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       Visibility="{Binding FloorId, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- 편집/삭제 버튼 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <!-- 수정 버튼 -->
                                            <Button Content="✏️" Width="24" Height="24" Margin="0,0,4,0"
                                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0"
                                                    Click="BtnEditMarker_Manual_Click" Tag="{Binding}"
                                                    Cursor="Hand" ToolTip="Edit marker">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        
                                        <!-- 삭제 버튼 -->
                                        <Button Content="✕" Width="24" Height="24" 
                                                Background="Transparent" Foreground="#FF4444" BorderThickness="0"
                                                Click="BtnDeleteMarker_Manual_Click" Tag="{Binding}"
                                                Cursor="Hand" ToolTip="Delete">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="Background" Value="#33FF0000"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 4: 활성 퀘스트 요구 아이템 및 열쇠 단일 스트립 바 (F11: Single compact horizontal strip) -->
        <Border Grid.Row="4" x:Name="MapRequirementsStripsPanel"
                Background="{StaticResource TacticalSurface1Brush}" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="0,1,0,1" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Required Items (Special Equipment Only) -->
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right: Required Keys (Without Stash Possession Indicator) -->
                    <ColumnDefinition Width="*" MinWidth="180"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Special Equipment Strip -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📦 Items for tasks:" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNoRequiredItems" Text="No active task items needed on this map" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" VerticalAlignment="Center"/>
                            <ItemsControl x:Name="RequiredItemsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource TacticalSurface3Brush}" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1" CornerRadius="4"
                                                Padding="6,3" Margin="0,0,6,0" ToolTip="{Binding QuestName}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding QuantityText}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Vertical Separator -->
                <Border Grid.Column="1" Width="1" Background="#2C2C34" Margin="10,2"/>

                <!-- Right: Required Keys Strip (Without Stash Possession Badge) -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔑 Keys for tasks:" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNoRequiredKeys" Text="No active task keys needed on this map" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" VerticalAlignment="Center"/>
                            <ItemsControl x:Name="RequiredKeysList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource TacticalSurface3Brush}" BorderBrush="{StaticResource TacticalBorderSubtleBrush}" BorderThickness="1" CornerRadius="4"
                                                Padding="6,2" Margin="0,0,6,0" ToolTip="{Binding TooltipText}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
                        <!-- Hidden compatibility controls -->
                    <StackPanel Visibility="Collapsed">
                        <ComboBox x:Name="CmbZoomLevel"/>
                        <Button x:Name="BtnExitFullScreen"/>
                        <Border x:Name="TarkovClockWidget" Visibility="Collapsed"/>
                    </StackPanel>
</Grid>
</UserControl>
