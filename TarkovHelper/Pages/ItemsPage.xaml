<UserControl x:Class="TarkovHelper.Pages.ItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TarkovHelper.Pages"
             xmlns:vm="clr-namespace:TarkovHelper.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Background="{DynamicResource TacticalSurface0Brush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Toggle Switch Style for Filter Popup (Foto 6) -->
        <Style x:Key="ModernToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <!-- Track -->
                            <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10"
                                    Background="#1C2028" BorderBrush="#323846" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <!-- Thumb -->
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#686E7C"
                                         HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#332B14"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#C5A84A"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#D8BB5C"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Segment Button Style for Filter Tabs -->
        <Style x:Key="PillTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14"
                                Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25252D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper Button Style for Item Cards -->
        <Style x:Key="CardStepperButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#25252D"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#3D3D48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33333E"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#404050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Compact Sort ComboBox Style -->
        <ControlTemplate x:Key="SortComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#1C1C22" BorderBrush="#33333E" BorderThickness="1"
                    CornerRadius="6" Height="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="#8A8A96" Data="M 0 0 L 3.5 3.5 L 7 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#25252E"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SortComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2A2A36"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#333342"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactSortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SortComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource SortComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,22,0" IsHitTestVisible="False">
                                <TextBlock Text="⇅ " FontSize="12" Foreground="#8A8A96" VerticalAlignment="Center"/>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1C1C22" BorderBrush="#33333E" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" Margin="0,3,0,0">
                                    <ScrollViewer MaxHeight="160" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <!-- 0: Controls Bar (Filter Tabs, Search, Actions) -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Cards Grid View -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Filters Bar (Pills, Search, Actions) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Filter Tabs (ALL, TASKS, HIDEOUT, COMPLETED) -->
                <ColumnDefinition Width="Auto"/>
                <!-- Left: Search Box -->
                <ColumnDefinition Width="Auto"/>
                <!-- Flexible Spacer -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Counter, Filters Button, Sort -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter Tabs Pills -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Name="TabAll" Style="{StaticResource PillTabButtonStyle}"
                             IsChecked="{Binding IsTabAll, Mode=OneWay}" Click="TabAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ALL" Margin="0,0,6,0"/>
                        <Border Background="#1C1C22" CornerRadius="10" Padding="6,1">
                            <TextBlock Text="{Binding AllCount}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="TabTasks" Style="{StaticResource PillTabButtonStyle}"
                             IsChecked="{Binding IsTabTasks, Mode=OneWay}" Click="TabTasks_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TASKS" Margin="0,0,6,0"/>
                        <Border Background="#1C1C22" CornerRadius="10" Padding="6,1">
                            <TextBlock Text="{Binding TasksCount}" FontSize="10" Foreground="#4EA8DE"/>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="TabHideout" Style="{StaticResource PillTabButtonStyle}"
                             IsChecked="{Binding IsTabHideout, Mode=OneWay}" Click="TabHideout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HIDEOUT" Margin="0,0,6,0"/>
                        <Border Background="#1C1C22" CornerRadius="10" Padding="6,1">
                            <TextBlock Text="{Binding HideoutCount}" FontSize="10" Foreground="#64D2B4"/>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="TabKappa" Style="{StaticResource PillTabButtonStyle}"
                             IsChecked="{Binding IsTabKappa, Mode=TwoWay}" Click="TabKappa_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KAPPA" Margin="0,0,6,0"/>
                        <Border Background="#1C1C22" CornerRadius="10" Padding="6,1">
                            <TextBlock Text="{Binding KappaCount}" FontSize="10" Foreground="#FFB74D"/>
                        </Border>
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="TabCompleted" Style="{StaticResource PillTabButtonStyle}"
                             IsChecked="{Binding IsTabCompleted, Mode=OneWay}" Click="TabCompleted_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="COMPLETED" Margin="0,0,6,0"/>
                        <Border Background="#1C1C22" CornerRadius="10" Padding="6,1">
                            <TextBlock Text="{Binding CompletedCount}" FontSize="10" Foreground="#81C784"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Search Box (Fixed 220px, Height 28px, Clean Watermark) -->
            <Border Grid.Column="1" Background="{DynamicResource TacticalSurface2Brush}" BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="6" Height="28" Width="220" Margin="12,0,0,0"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#6E6E78"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- Placeholder text when empty -->
                    <TextBlock Grid.Column="1" Text="Search items, quests..." FontSize="11" Foreground="#5E5E68"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="TxtSearchBox" Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="11.5" VerticalAlignment="Center"
                             VerticalContentAlignment="Center" Padding="0"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="20" Height="20"
                            Background="Transparent" BorderThickness="0" Foreground="#7E7E88"
                            FontSize="10" Cursor="Hand" Click="BtnClearSearch_Click" Margin="0,0,2,0"
                            Visibility="{Binding SearchText, Converter={StaticResource BoolToVisConverter}}"/>
                </Grid>
            </Border>

            <!-- Right Controls: Counter, Filters Button, Sort Dropdown -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Items counter (e.g. 452 items) -->
                <TextBlock Text="{Binding FilteredCountText}" FontSize="11" FontWeight="Medium"
                           Foreground="#888894" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Filters Popup Button (Foto 6) -->
                <Button x:Name="BtnFilters" Click="BtnFilters_Click"
                        Height="28" Padding="10,0" Margin="0,0,8,0"
                        Background="#1C1C22" BorderBrush="#33333E" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="≡" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="#8A8A96"/>
                                    <TextBlock Text="FILTERS" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ▾" FontSize="9" Foreground="#8A8A96" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#25252E"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Sort ComboBox -->
                <ComboBox x:Name="CmbSortMode" Style="{StaticResource CompactSortComboBoxStyle}"
                          SelectionChanged="CmbSortMode_SelectionChanged"
                          Width="110" Height="28">
                    <ComboBoxItem Content="Priority" Tag="Priority" IsSelected="True"/>
                    <ComboBoxItem Content="Name" Tag="Name"/>
                    <ComboBoxItem Content="Trader" Tag="Trader"/>
                    <ComboBoxItem Content="Quantity" Tag="Quantity"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Filters Popup (Foto 6: Filter items with toggles) -->
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=BtnFilters}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#18181C" BorderBrush="#33333E" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,6,0,0" Width="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Header: Filter items & Reset -->
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Filter items" FontSize="13.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnResetFilters" Content="🔄 Reset" Click="BtnResetFilters_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"
                                HorizontalAlignment="Right" Cursor="Hand" ToolTip="Reset all filters to default"/>
                    </Grid>

                    <!-- Section 1: FOUND IN RAID -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="FOUND IN RAID" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                        <TextBlock Text="Show only items that need to be found in raid, or only the ones that don't."
                                   FontSize="10" Foreground="#888894" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- 3-Button Segment Toggle: [All] [FIR] [Non-FIR] -->
                        <Border Background="#141418" BorderBrush="#2C2C34" BorderThickness="1"
                                CornerRadius="6" Padding="2" Height="28">
                            <UniformGrid Columns="3" Rows="1">
                                <RadioButton x:Name="RadioFirAll" Content="All" Click="RadioFir_Click"
                                             IsChecked="{Binding IsFirAll, Mode=OneWay}"
                                             Style="{StaticResource PillTabButtonStyle}" Padding="0" Margin="1,0"/>
                                <RadioButton x:Name="RadioFirOnly" Content="FIR" Click="RadioFir_Click"
                                             IsChecked="{Binding IsFirOnly, Mode=OneWay}"
                                             Style="{StaticResource PillTabButtonStyle}" Padding="0" Margin="1,0"/>
                                <RadioButton x:Name="RadioFirNon" Content="Non-FIR" Click="RadioFir_Click"
                                             IsChecked="{Binding IsFirNon, Mode=OneWay}"
                                             Style="{StaticResource PillTabButtonStyle}" Padding="0" Margin="1,0"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <!-- Section 2: HIDE -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="HIDE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- Items I already have -->
                        <CheckBox x:Name="ChkHideOwned" Style="{StaticResource ModernToggleSwitchStyle}"
                                  IsChecked="{Binding HideOwned, Mode=TwoWay}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Items I already have" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Hide needs you already have enough of." FontSize="10"
                                           Foreground="#888894" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Non-FIR special equipment -->
                        <CheckBox x:Name="ChkHideSpecial" Style="{StaticResource ModernToggleSwitchStyle}"
                                  IsChecked="{Binding HideSpecialEquipment, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Non-FIR special equipment" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Hide placeable task gear such as MS2000 Markers and Wi-Fi Cameras."
                                           FontSize="10" Foreground="#888894" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>

                    <!-- Section 3: TASKS -->
                    <StackPanel>
                        <TextBlock Text="TASKS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                        <!-- Kappa tasks only -->
                        <CheckBox x:Name="ChkKappaOnly" Style="{StaticResource ModernToggleSwitchStyle}"
                                  IsChecked="{Binding KappaOnly, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Kappa tasks only" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Show only task items needed for the Kappa container."
                                           FontSize="10" Foreground="#888894" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Row 1: Cards Grid View (Foto 3) -->
        <ScrollViewer x:Name="CardsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="CardsScrollViewer_ScrollChanged">
            <ItemsControl ItemsSource="{Binding DisplayedCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="164" Height="226" Margin="5" Padding="9,8"
                                Background="{DynamicResource TacticalSurface2Brush}"
                                BorderBrush="{DynamicResource TacticalBorderMediumBrush}"
                                BorderThickness="1"
                                CornerRadius="6" Opacity="{Binding CardOpacity}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource TacticalBorderGoldBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource TacticalSurface3Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- 0: Top Status / Badges Row -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 1: Center Item Image -->
                                    <RowDefinition Height="74"/>
                                    <!-- 2: Item Name -->
                                    <RowDefinition Height="34"/>
                                    <!-- 3: Source Pill (Trader / Station) -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- 4: Interactive Stepper ([-] 0/N [+] [✓]) -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Top Status Badges -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ProgressText}" FontFamily="{DynamicResource TacticalDisplayFont}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding StatusBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <!-- Dogtag requirement badge -->
                                        <Border Background="#25252E" BorderBrush="#3D3D48" BorderThickness="1"
                                                CornerRadius="3" Padding="4,1" Margin="0,0,3,0"
                                                Visibility="{Binding DogtagVisibility}">
                                            <TextBlock Text="{Binding DogtagDisplay}" FontSize="8.5" FontWeight="Bold" Foreground="#A0A0B0"/>
                                        </Border>

                                        <!-- FIR Badge -->
                                        <Border Background="#4A3414" BorderBrush="#8A6020" BorderThickness="1"
                                                CornerRadius="3" Padding="4,1"
                                                Visibility="{Binding FirVisibility}">
                                            <TextBlock Text="✓ FIR" FontSize="8.5" FontWeight="Bold" Foreground="#E5C86A"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Item Image Centered in EFT-Style Slot Cell -->
                                <Border Grid.Row="1" Width="72" Height="72" CornerRadius="4"
                                        Background="#101216" BorderBrush="#242832" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding IconSource}" Width="66" Height="66" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Row 2: Item Name -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding ItemDisplayName}" FontWeight="Bold" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               ToolTip="{Binding ItemDisplayName}"/>
                                    <TextBlock Text="{Binding SubtitleName}" FontSize="9"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                               Visibility="{Binding SubtitleVisibility}"/>
                                </StackPanel>

                                <!-- Row 3: Source Badge (Trader avatar + Quest title / Station) -->
                                <Border Grid.Row="3" Background="#141418" BorderBrush="#2A2A32" BorderThickness="1"
                                        CornerRadius="4" Padding="4,2" Margin="0,2,0,6"
                                        Cursor="Hand" MouseLeftButtonUp="SourcePill_Click"
                                        ToolTip="Click to view quest/station requirements">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Trader Avatar / Station Initial Icon -->
                                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="2"
                                                Background="#202028" BorderBrush="#3A3A46" BorderThickness="1"
                                                ClipToBounds="True" VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{Binding TraderAvatar}" Width="16" Height="16" Stretch="UniformToFill"
                                                       Visibility="{Binding HasTraderAvatar, Converter={StaticResource BoolToVisConverter}}"/>
                                                <TextBlock Text="{Binding TraderInitial}" FontSize="8.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Quest / Station Title -->
                                        <TextBlock Grid.Column="1" Text="{Binding SourceName}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#4EA8DE" TextTrimming="CharacterEllipsis"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Row 4: Interactive Stepper ([-] 0/N [+] [✓]) -->
                                <Border Grid.Row="4" Background="#141418" BorderBrush="#25252C" BorderThickness="1"
                                        CornerRadius="4" Padding="2,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Decrement Button -->
                                        <Button Grid.Column="0" Content="−" Style="{StaticResource CardStepperButtonStyle}"
                                                Click="BtnCardMinus_Click" ToolTip="Decrease count"/>

                                        <!-- Count Display -->
                                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{Binding StatusBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <!-- Increment Button -->
                                        <Button Grid.Column="2" Content="+" Style="{StaticResource CardStepperButtonStyle}"
                                                Click="BtnCardPlus_Click" ToolTip="Increase count"/>

                                        <!-- Toggle Complete Button -->
                                        <Button Grid.Column="3" Content="✓" Style="{StaticResource CardStepperButtonStyle}"
                                                Click="BtnCardComplete_Click" Margin="2,0,0,0"
                                                Foreground="#81C784" ToolTip="Toggle complete / clear"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
