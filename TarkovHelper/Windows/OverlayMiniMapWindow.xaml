<Window x:Class="TarkovHelper.Windows.OverlayMiniMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        mc:Ignorable="d"
        Title="WidgetOverlay"
        Width="300" Height="300"
        MinWidth="200" MinHeight="200"
        MaxWidth="1600" MaxHeight="1600"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        ToolTipService.ShowDuration="30000"
        ToolTipService.InitialShowDelay="300"
        ToolTipService.BetweenShowDelay="100"
        Background="Transparent">

    <Window.Resources>
        <!-- Global ToolTip Style: dark high-contrast background (#EE1A1A1E), subtle border (#55FFFFFF), rounded corners (CornerRadius=4) -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#EE1A1A1E"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                TextBlock.FontSize="{TemplateBinding FontSize}"
                                TextBlock.FontWeight="{TemplateBinding FontWeight}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dark ContextMenu Style (#1A1A1E) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Clean 1px Separator Style (#2AFFFFFF) -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Background" Value="#2AFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniMapFloatingBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#CC1A1A1E"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#EE2E2E36"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#FF42424E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarMapSelectorBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarWindowBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#C4101E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 메인 컨테이너 - 반투명 테두리와 맵 표시 -->
    <Border x:Name="MainBorder"
            Background="#BB111111"
            BorderThickness="1"
            BorderBrush="#44FFFFFF"
            CornerRadius="4"
            ClipToBounds="True"
            ContextMenuOpening="MainBorder_ContextMenuOpening">
        <Border.ContextMenu>
            <ContextMenu Background="#1A1A1E" Foreground="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                <ContextMenu.Resources>
                    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuHeaderTemplateKey}" TargetType="MenuItem">
                        <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderThickness="0" Padding="8,4" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                                <Path Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#AAAAAA"/>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" Focusable="False">
                                    <Border x:Name="SubMenuBorder" Background="#1A1A1E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="2">
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                    <ControlTemplate x:Key="{x:Static MenuItem.SubmenuItemTemplateKey}" TargetType="MenuItem">
                        <Border x:Name="templateRoot" Background="{TemplateBinding Background}" BorderThickness="0" Padding="8,4" CornerRadius="2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ContextMenu.Resources>
                <MenuItem x:Name="MenuAddCustomMarker" Header="Add Custom Marker Here..." Click="MenuAddCustomMarker_Click" Foreground="#FFD700" FontWeight="SemiBold"/>
                <Separator/>
                <MenuItem Header="Overlay Settings... (Ctrl+7)" Click="MenuSettings_Click" Foreground="#FFFFFF"/>
                <MenuItem Header="Custom Marker Size">
                    <MenuItem Header="Small" Click="MenuMarkerPreset_Click" Tag="Small"/>
                    <MenuItem Header="Normal (Default)" Click="MenuMarkerPreset_Click" Tag="Normal"/>
                    <MenuItem Header="Large" Click="MenuMarkerPreset_Click" Tag="Large"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuCenterPlayer" Header="Center on Player" Click="MenuCenterPlayer_Click" Foreground="#FFFFFF"/>
                <MenuItem x:Name="MenuClickThrough" Header="Toggle Click-Through (Ctrl+9)" Click="MenuClickThrough_Click" Foreground="#FFFFFF"/>
                <Separator/>
                <MenuItem Header="Reset View (Fit Map)" Click="MenuResetView_Click" Foreground="#FFFFFF"/>
                <Separator/>
                <MenuItem Header="Close Minimap" Click="MenuClose_Click" Foreground="#FF6B6B"/>
            </ContextMenu>
        </Border.ContextMenu>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- 상단 타이틀 바: 윈도우 드래그 이동 및 버튼 -->
            <Border Grid.Row="0" Background="#EE202023" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1"
                    Panel.ZIndex="10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    PreviewMouseRightButtonDown="TitleBar_PreviewMouseRightButtonDown"
                    Cursor="SizeAll"
                    ToolTip="Drag here to move window">
            <Grid x:Name="TitleBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⠿" Foreground="#AAAAAA" FontSize="13" Margin="8,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Map Selector in Header (R4) -->
                        <Button x:Name="BtnTitleMapSelector"
                                Style="{StaticResource TitleBarMapSelectorBtnStyle}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="4,0,0,0" ToolTip="Click to select map"
                                Click="BtnTitleMapSelector_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MapSelectorContextMenu"
                                             Background="#1A1A1E" Foreground="#FFFFFF"
                                             BorderBrush="#33FFFFFF" BorderThickness="1"
                                             Placement="Bottom"/>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTitleMapName" Text="Minimap" Foreground="#EEEEEE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▾" Foreground="#AAAAAA" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Synchronized Floor Stepper (⬆⬇ / Pisos) -->
                        <StackPanel x:Name="PnlFloorSelector" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed">
                            <Button x:Name="BtnFloorDown" Width="18" Height="20" Content="▼" FontSize="9"
                                    Style="{StaticResource TitleBarWindowBtnStyle}" ToolTip="Previous Floor / Bajar Piso" Click="BtnFloorDown_Click"/>
                            <TextBlock x:Name="TxtMiniMapFloor" Text="G" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="2,0,2,0" MinWidth="16" TextAlignment="Center"/>
                            <Button x:Name="BtnFloorUp" Width="18" Height="20" Content="▲" FontSize="9"
                                    Style="{StaticResource TitleBarWindowBtnStyle}" ToolTip="Next Floor / Subir Piso" Click="BtnFloorUp_Click"/>
                        </StackPanel>

                        <!-- Zoom and Reset Controls (Placed on the left, next to floor selector) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button x:Name="BtnZoomIn" Width="20" Height="20" Content="+"
                                    FontSize="12" FontWeight="Bold"
                                    Style="{StaticResource TitleBarWindowBtnStyle}"
                                    ToolTip="Zoom In (+)" Click="BtnZoomIn_Click"/>
                            <Button x:Name="BtnZoomOut" Width="20" Height="20" Content="-"
                                    FontSize="12" FontWeight="Bold"
                                    Style="{StaticResource TitleBarWindowBtnStyle}"
                                    ToolTip="Zoom Out (-)" Click="BtnZoomOut_Click"/>
                            <Button x:Name="BtnFitMap" Width="20" Height="20" Content="⟲"
                                    FontSize="10"
                                    Style="{StaticResource TitleBarWindowBtnStyle}"
                                    ToolTip="Fit Map / Reset View (⟲)" Click="BtnFitMap_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Open / Call Main Application from Tray -->
                    <Button x:Name="BtnOpenApp" Grid.Column="2"
                            Style="{StaticResource TitleBarWindowBtnStyle}"
                            Margin="0,0,2,0"
                            ToolTip="Abrir Tarkov Helper / Open Tarkov Helper"
                            Click="BtnOpenApp_Click">
                        <Grid Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="M 1,3.5 L 1,11 L 8.5,11 L 8.5,3.5 Z M 1,5.5 L 8.5,5.5 M 4,1.5 L 11,1.5 L 11,8.5 L 8.5,8.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  SnapsToDevicePixels="True"/>
                        </Grid>
                    </Button>

                    <Button x:Name="BtnSettings" Grid.Column="3" Content="⚙"
                            Style="{StaticResource TitleBarWindowBtnStyle}"
                            Margin="0,0,2,0"
                            ToolTip="Overlay Settings (Ctrl+7)" Click="MenuSettings_Click"/>
                    <Button x:Name="BtnMinimize" Grid.Column="4" Content="_"
                            Style="{StaticResource TitleBarWindowBtnStyle}"
                            Margin="0,0,2,0"
                            FontSize="11" FontWeight="Bold"
                            ToolTip="Minimize" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnClose" Grid.Column="5" Content="✕"
                            Style="{StaticResource TitleBarCloseBtnStyle}"
                            Margin="0,0,4,0"
                            FontSize="11"
                            ToolTip="Close Minimap" Click="MenuClose_Click"/>
                </Grid>
            </Border>

            <!-- 맵 영역 (Row 1): 좌클릭 드래그로 맵 이동(Pan), 휠로 줌, 우클릭으로 마커 추가 -->
            <Grid x:Name="MapContainer" Grid.Row="1" Background="Transparent"
                  ClipToBounds="True"
                  PreviewMouseWheel="MapContainer_PreviewMouseWheel"
                  MouseLeftButtonDown="MapContainer_MouseLeftButtonDown"
                  MouseDown="MapContainer_MouseDown"
                  MouseUp="MapContainer_MouseUp"
                  MouseMove="MapContainer_MouseMove"
                  MouseLeftButtonUp="MapContainer_MouseLeftButtonUp"
                  PreviewMouseRightButtonDown="MapContainer_PreviewMouseRightButtonDown">
                <!-- 맵 캔버스 -->
                <Canvas x:Name="MapCanvas"
                        Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ClipToBounds="False">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MapScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="MapTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- SVG 맵 이미지 -->
                    <svgc:SvgViewbox x:Name="MapSvg" Stretch="None"/>

                    <!-- 플레이어 이동 경로 (TrailPath) -->
                    <Polyline x:Name="TrailPath" Stroke="#80FF5722"
                              StrokeThickness="2" StrokeLineJoin="Round"/>

                    <!-- 맵 마커 컨테이너 (Spawns, Bosses, Snipers, Levers) -->
                    <Canvas x:Name="MapMarkersContainer" ClipToBounds="False"/>

                    <!-- 탈출구 마커 컨테이너 -->
                    <Canvas x:Name="ExtractMarkersContainer" ClipToBounds="False"/>

                    <!-- 퀘스트 마커 컨테이너 -->
                    <Canvas x:Name="QuestMarkersContainer" ClipToBounds="False"/>

                    <!-- 커스텀 마커 컨테이너 -->
                    <Canvas x:Name="CustomMarkersContainer" ClipToBounds="False"/>

                    <!-- 플레이어 마커 -->
                    <Canvas x:Name="PlayerMarkerContainer" Visibility="Collapsed">
                        <Canvas.RenderTransform>
                            <ScaleTransform x:Name="PlayerMarkerScale" ScaleX="1" ScaleY="1" CenterX="10" CenterY="10"/>
                        </Canvas.RenderTransform>
                        
                        <!-- 외곽 원 (테두리) -->
                        <Ellipse x:Name="PlayerOuterCircle"
                                 Width="20" Height="20"
                                 Fill="#442196F3"
                                 Stroke="#2196F3"
                                 StrokeThickness="2"/>

                        <!-- 내부 원 -->
                        <Ellipse x:Name="PlayerInnerCircle"
                                 Width="10" Height="10"
                                 Fill="#2196F3"
                                 Canvas.Left="5" Canvas.Top="5"/>

                        <!-- 방향 화살표 -->
                        <Polygon x:Name="PlayerDirectionArrow"
                                 Points="0,0 5,-12 10,0"
                                 Fill="#882196F3"
                                 Canvas.Left="5" Canvas.Top="-8">
                            <Polygon.RenderTransform>
                                <RotateTransform x:Name="PlayerRotation" Angle="0" CenterX="5" CenterY="18"/>
                            </Polygon.RenderTransform>
                        </Polygon>
                    </Canvas>
                </Canvas>

                <!-- 맵 없음 메시지 -->
                <TextBlock x:Name="TxtNoMap"
                           Text="No map selected"
                           Foreground="#666666"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>

                <!-- Hidden legacy recenter button kept for compatibility -->
                <Button x:Name="BtnRecenter"
                        Visibility="Collapsed"
                        Width="0" Height="0"
                        IsHitTestVisible="False"
                        Click="BtnRecenter_Click"/>
            </Grid>

            <!-- Dedicated Bottom Toolbar Bar (Row 2): Fully isolated from map canvas to prevent overlap/obscuring -->
            <Border Grid.Row="2" Background="#EE202023" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Control Group: Tactical Compact Text Buttons (Zero Emojis) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                        <!-- PMC Extracts -->
                        <Button x:Name="BtnTogglePmcExtracts" Height="23" Padding="6,0" Content="Pmc"
                                FontSize="10.5" FontWeight="Bold" Margin="1,0"
                                Style="{StaticResource MiniMapFloatingBtnStyle}"
                                ToolTip="PMC Extractions (+ Co-op in Cyan)"
                                Click="BtnTogglePmcExtracts_Click"/>

                        <!-- Scav Extracts -->
                        <Button x:Name="BtnToggleScavExtracts" Height="23" Padding="6,0" Content="Scav"
                                FontSize="10.5" FontWeight="SemiBold" Margin="1,0"
                                Style="{StaticResource MiniMapFloatingBtnStyle}"
                                ToolTip="Scav Extractions (+ Co-op in Cyan)"
                                Click="BtnToggleScavExtracts_Click"/>

                        <!-- Quests -->
                        <Button x:Name="BtnToggleQuests" Height="23" Padding="6,0" Content="Tasks"
                                FontSize="10.5" FontWeight="SemiBold" Margin="1,0"
                                Style="{StaticResource MiniMapFloatingBtnStyle}"
                                ToolTip="Toggle Quest Objectives"
                                Click="BtnToggleQuests_Click"/>

                        <!-- PMC Spawns -->
                        <Button x:Name="BtnTogglePmcSpawns" Height="23" Padding="6,0" Content="Spawns"
                                FontSize="10.5" FontWeight="SemiBold" Margin="1,0"
                                Style="{StaticResource MiniMapFloatingBtnStyle}"
                                ToolTip="PMC Spawns"
                                Click="BtnTogglePmcSpawns_Click"/>

                        <!-- POIs / Bosses -->
                        <Button x:Name="BtnTogglePois" Height="23" Padding="6,0" Content="Boss"
                                FontSize="10.5" FontWeight="SemiBold" Margin="1,0"
                                Style="{StaticResource MiniMapFloatingBtnStyle}"
                                ToolTip="Toggle Tactical POIs &amp; Bosses"
                                Click="BtnTogglePois_Click"/>

                        <!-- Subtle Divider between Layers and Actions -->
                        <Rectangle Width="1" Height="14" Fill="#33FFFFFF" Margin="4,0,4,0" VerticalAlignment="Center"/>

                        <!-- Clear Raid Trail -->
                        <Button x:Name="BtnClearPlayerTrail" Height="23" Padding="6,0" Content="Clear"
                                FontSize="10.5" FontWeight="SemiBold" Margin="1,0"
                                Style="{StaticResource MiniMapFloatingBtnStyle}"
                                ToolTip="Clear Raid Trail"
                                Click="BtnClearPlayerTrail_Click"/>

                        <!-- Click-Through (Ctrl+9) -->
                        <Button x:Name="BtnToggleClickThrough" Height="23" Padding="6,0" Content="Click"
                                FontSize="10.5" FontWeight="SemiBold" Margin="1,0"
                                Style="{StaticResource MiniMapFloatingBtnStyle}"
                                ToolTip="Toggle Click-Through (Ctrl+9)"
                                Click="BtnToggleClickThrough_Click"/>
                    </StackPanel>

                    <!-- Resize Grip -->
                    <Path Grid.Column="1" Data="M 0,10 L 10,0 M 3,10 L 10,3 M 6,10 L 10,6"
                          Stroke="#55FFFFFF"
                          StrokeThickness="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="0,0,2,2"
                          IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
