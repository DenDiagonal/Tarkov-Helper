<Window x:Class="TarkovHelper.Windows.Dialogs.DiffViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Audit &amp; Comparison"
        Width="960" Height="700"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <Style x:Key="FilterTabButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource TacticalSurface1Brush}"
            BorderBrush="{DynamicResource TacticalBorderMediumBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Summary Bar -->
                <RowDefinition Height="Auto"/> <!-- Filter Tabs -->
                <RowDefinition Height="*"/>    <!-- Content &amp; Rollback Overlay -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtDialogTitle" Text="Data Audit &amp; Comparison (Diff Engine)"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TacticalGoldBrush}"/>
                    <TextBlock x:Name="TxtDialogSubtitle" Text="Comparison of local database against official Wiki and community sources"
                               FontSize="12" Foreground="{DynamicResource TacticalTextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnClose" Content="✕"
                        Style="{StaticResource DialogActionButtonStyle}"
                        Background="Transparent" Foreground="{DynamicResource TacticalTextSecondaryBrush}"
                        FontSize="16" FontWeight="Bold"
                        Padding="8,4" BorderThickness="0"
                        Click="BtnClose_Click"/>
            </Grid>

            <!-- Row 1: Summary Bar -->
            <Border Grid.Row="1" Background="{DynamicResource TacticalSurface2Brush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,14" BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Summary of Changes:" FontWeight="SemiBold" Foreground="{DynamicResource TacticalTextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <!-- Total Badge -->
                    <Border Grid.Column="1" Background="#2E2E34" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtTotalChanges" Text="Total: 0" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Added Badge -->
                    <Border Grid.Column="2" Background="#1B5E20" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtAddedCount" Text="+ 0 Added" FontSize="12" FontWeight="SemiBold" Foreground="#A5D6A7"/>
                    </Border>

                    <!-- Modified Badge -->
                    <Border Grid.Column="3" Background="#E65100" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtModifiedCount" Text="~ 0 Modified" FontSize="12" FontWeight="SemiBold" Foreground="#FFE082"/>
                    </Border>

                    <!-- Removed Badge -->
                    <Border Grid.Column="4" Background="#B71C1C" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtRemovedCount" Text="- 0 Removed" FontSize="12" FontWeight="SemiBold" Foreground="#FFCDD2"/>
                    </Border>

                    <!-- Database path info -->
                    <TextBlock Grid.Column="5" x:Name="TxtDbPath" Text="" FontSize="11" Foreground="#757575"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- Row 2: Filter Tabs Bar -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,12" Orientation="Horizontal">
                <Button x:Name="BtnFilterAll" Content="All (0)" Style="{StaticResource FilterTabButtonStyle}" Click="BtnFilterTab_Click"/>
                <Button x:Name="BtnFilterQuests" Content="Tasks (0)" Style="{StaticResource FilterTabButtonStyle}" Click="BtnFilterTab_Click"/>
                <Button x:Name="BtnFilterRequirements" Content="Requirements (0)" Style="{StaticResource FilterTabButtonStyle}" Click="BtnFilterTab_Click"/>
                <Button x:Name="BtnFilterItems" Content="Items (0)" Style="{StaticResource FilterTabButtonStyle}" Click="BtnFilterTab_Click"/>
                <Button x:Name="BtnFilterHideout" Content="Hideout (0)" Style="{StaticResource FilterTabButtonStyle}" Click="BtnFilterTab_Click"/>
            </WrapPanel>

            <!-- Row 3: Main Content Area &amp; Rollback Overlay -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <!-- Layer 1: Diff Cards Content -->
                <Grid x:Name="DiffContentLayer">
                    <!-- Empty State: No changes found -->
                    <Border x:Name="EmptyStateBorder" Background="#202024" CornerRadius="6" Padding="32"
                            VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600"
                            BorderBrush="{DynamicResource TacticalBorderSubtleBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="44" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Local database is synchronized. No changes found."
                                       FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TacticalTextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="All task titles, minimum levels, prerequisites, task items, and Hideout modules match audited remote sources."
                                       FontSize="12" Foreground="{DynamicResource TacticalTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                            <Button Content="View Previous Backups (Rollback)"
                                    Style="{StaticResource DialogActionButtonStyle}"
                                    Background="#2A2A30" Foreground="{DynamicResource TacticalGoldBrush}" BorderBrush="#C8AA6E" BorderThickness="1"
                                    Padding="14,8" HorizontalAlignment="Center"
                                    Click="BtnRollback_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable list of Diff Cards -->
                    <ScrollViewer x:Name="DiffCardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DiffCardsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource TacticalSurface2Brush}"
                                            BorderBrush="{Binding AccentColorHex}"
                                            BorderThickness="3,1,1,1"
                                            CornerRadius="4"
                                            Margin="0,0,0,8"
                                            Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Card Header (Category, Badge, Title) -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Category Pill -->
                                                <Border Background="{DynamicResource TacticalSurface1Brush}" BorderBrush="{DynamicResource TacticalBorderMediumBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TacticalGoldBrush}"/>
                                                </Border>

                                                <!-- Change Type Badge Pill -->
                                                <Border Background="{Binding BadgeBackgroundHex}" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding ChangeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding AccentColorHex}"/>
                                                </Border>

                                                <!-- Title -->
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Row 1: Summary Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TacticalTextSecondaryBrush}" Margin="0,6,0,6" TextWrapping="Wrap"/>

                                            <!-- Row 2: Property Changes Table (Old vs New) -->
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding PropertyChanges}" Visibility="{Binding PropertyChangesVisibility}" Margin="0,4,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="220"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayPropertyName}" FontWeight="SemiBold" Foreground="#D0D0D0" FontSize="12"/>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayOldValue}" Foreground="#EF9A9A" TextDecorations="Strikethrough" FontSize="12" Margin="0,0,8,0"/>
                                                                <TextBlock Text="➔" Foreground="{DynamicResource TacticalTextSecondaryBrush}" FontSize="12" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding DisplayNewValue}" Foreground="#A5D6A7" FontWeight="Bold" FontSize="12"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Row 3: Prerequisites Changes -->
                                            <StackPanel Grid.Row="3" Visibility="{Binding PrerequisitesVisibility}" Margin="0,4,0,2">
                                                <!-- Added Prerequisites -->
                                                <ItemsControl ItemsSource="{Binding AddedPrerequisites}" Visibility="{Binding AddedPrerequisitesVisibility}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="+ Prerequisite added: " Foreground="#81C784" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding}" Foreground="#A5D6A7" FontSize="11"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Removed Prerequisites -->
                                                <ItemsControl ItemsSource="{Binding RemovedPrerequisites}" Visibility="{Binding RemovedPrerequisitesVisibility}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                <TextBlock Text="- Prerequisite removed: " Foreground="#E57373" FontWeight="SemiBold" FontSize="11"/>
                                                                <TextBlock Text="{Binding}" Foreground="#FFCDD2" TextDecorations="Strikethrough" FontSize="11"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Layer 2: Rollback Panel Overlay -->
                <Border x:Name="RollbackOverlay" Visibility="Collapsed" Background="#F01A1A1E" CornerRadius="6" Padding="20" BorderBrush="#C8AA6E" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Restore Previous Backup (Rollback)"
                                   FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TacticalGoldBrush}" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Text="Select a backup file (.bak) to restore 'tarkov_data.db'. Current state will be overwritten with the chosen backup."
                                   FontSize="12" Foreground="{DynamicResource TacticalTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Backups List -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <!-- Empty backups message -->
                            <TextBlock x:Name="TxtNoBackups" Text="No previous backups found in application directory."
                                       Foreground="#EF5350" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

                            <!-- List of Backups -->
                            <ListBox x:Name="BackupListBox" Background="#202024" BorderBrush="{DynamicResource TacticalBorderMediumBrush}" BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#26262B" BorderBrush="{DynamicResource TacticalBorderMediumBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FileName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding FilePath}" Foreground="#757575" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding FormattedTimestamp}" Foreground="{DynamicResource TacticalTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0"/>

                                                <Border Grid.Column="2" Background="#2D2D32" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TacticalGoldBrush}" FontWeight="Bold" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <!-- Status text -->
                        <TextBlock Grid.Row="3" x:Name="TxtRollbackStatus" Text="" FontSize="12" Foreground="{DynamicResource TacticalTextPrimaryBrush}" Margin="0,0,0,8"/>

                        <!-- Actions inside Rollback -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancelRollback" Content="Back to Diffs"
                                    Style="{StaticResource DialogActionButtonStyle}"
                                    Background="#333338" Foreground="{DynamicResource TacticalTextPrimaryBrush}" Padding="16,8" Margin="0,0,10,0"
                                    Click="BtnCancelRollback_Click"/>
                            <Button x:Name="BtnConfirmRollback" Content="Restore Selected Backup"
                                    Style="{StaticResource DialogActionButtonStyle}"
                                    Background="#C8AA6E" Foreground="#1A1A1E" FontWeight="SemiBold" Padding="18,8"
                                    Click="BtnConfirmRollback_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 4: Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Rollback Button -->
                <Button Grid.Column="0" x:Name="BtnRollback" Content="⟲ Restore Previous Backup"
                        Style="{StaticResource DialogActionButtonStyle}"
                        Background="{DynamicResource TacticalSurface2Brush}" Foreground="{DynamicResource TacticalGoldBrush}" BorderBrush="#C8AA6E" BorderThickness="1"
                        Padding="16,8"
                        Click="BtnRollback_Click"
                        ToolTip="View and restore previous backups (.bak)"/>

                <!-- Right: Cancel &amp; Apply Changes -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnCancel" Content="Cancel"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Background="#333338" Foreground="{DynamicResource TacticalTextPrimaryBrush}"
                            Padding="18,8" Margin="0,0,12,0"
                            Click="BtnClose_Click"/>

                    <Button x:Name="BtnApplyChanges" Content="Confirm &amp; Apply Changes"
                            Style="{StaticResource DialogActionButtonStyle}"
                            Background="#C8AA6E" Foreground="#1A1A1E" FontWeight="SemiBold"
                            Padding="20,8"
                            Click="BtnApplyChanges_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
