<Window x:Class="TarkovHelper.Windows.QuestObjectiveRelocationManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Objective Relocation &amp; History Manager" Width="960" Height="680" MinWidth="850" MinHeight="550" WindowStartupLocation="CenterOwner" Background="#0D0E11" Foreground="#EDEDED" xmlns:windows="clr-namespace:TarkovHelper.Windows;assembly=TarkovHelper">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AccentGoldBrush" Color="#C5A84A" />
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#131519" />
      <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1A1D23" />
      <SolidColorBrush x:Key="SubtleBorderBrush" Color="#242832" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#686E7C" />
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="#222227" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Style.Triggers>
          <Trigger Property="TabItem.IsSelected" Value="True">
            <Setter Property="Background" Value="#2E2E36" />
            <Setter Property="Foreground" Value="#FFD700" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#2A2A32" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="BorderBrush" Value="#44FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#25252B" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="BorderBrush" Value="#44FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="TextBoxBase.CaretBrush" Value="#FFD700" />
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="#25252B" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="BorderBrush" Value="#44FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
      </Style>
      <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#1C1C22" />
        <Setter Property="Foreground" Value="#F0F0F0" />
        <Setter Property="DataGrid.RowBackground" Value="#202026" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#25252D" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#1AFFFFFF" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.AutoGenerateColumns" Value="False" />
        <Setter Property="DataGrid.CanUserAddRows" Value="False" />
        <Setter Property="DataGrid.CanUserDeleteRows" Value="False" />
        <Setter Property="DataGrid.SelectionMode" Value="Single" />
        <Setter Property="DataGrid.RowHeaderWidth" Value="0" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#2A2A33" />
        <Setter Property="Foreground" Value="#FFD700" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridCell}">
              <Border Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="DataGridCell.IsSelected" Value="True">
            <Setter Property="Background" Value="#3E3E50" />
            <Setter Property="Foreground" Value="#FFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#202026" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderBrush="#33FFFFFF" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="🎯 Objective Relocation Manager &amp; History" FontSize="17" FontWeight="Bold" Foreground="#C5A84A" />
          <TextBlock Text="Locate, interactively relocate, or restore quest objective coordinates to factory defaults." FontSize="12" Foreground="#A0A0A5" Margin="0,3,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="Close" Padding="14,6" VerticalAlignment="Center" Click="BtnClose_Click" />
      </Grid>
    </Border>
    <TabControl Grid.Row="1" Background="#202026" BorderBrush="#33FFFFFF">
      <TabItem Header="🔍 Search &amp; Relocate">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#26262E" CornerRadius="4" Padding="10" Margin="0,0,0,10" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Name="TxtSearchQuery" Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" ToolTip="Search by task name, description, or objective..." KeyDown="TxtSearchQuery_KeyDown" />
              <ComboBox Name="CmbTraderFilter" Grid.Row="0" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="FilterChanged" />
              <ComboBox Name="CmbMapFilter" Grid.Row="0" Grid.Column="2" Margin="0,0,8,0" SelectionChanged="FilterChanged" />
              <Button Name="BtnSearch" Grid.Row="0" Grid.Column="3" Content="Search" Padding="16,4" Click="BtnSearch_Click" />
              <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Name="ChkGeographicOnly" Content="Only objectives with geographic significance" IsChecked="True" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,20,0" Checked="FilterChanged" Unchecked="FilterChanged" />
                <CheckBox Name="ChkWithoutCoordsOnly" Content="Only objectives without coordinates" IsChecked="False" Foreground="#E0E0E0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged" />
                <TextBlock Name="TxtSearchResultCount" Text="0 objectives found" Foreground="#A0A0A5" VerticalAlignment="Center" Margin="20,0,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <DataGrid Name="GridSearchResults" Grid.Row="1" SelectionChanged="GridSearchResults_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Task" Width="160" Binding="{Binding QuestName}" />
              <DataGridTextColumn Header="Comerciante" Width="100" Binding="{Binding Trader}" />
              <DataGridTextColumn Header="Mapa" Width="100" Binding="{Binding MapName}" />
              <DataGridTextColumn Header="Tipo" Width="75" Binding="{Binding Type}" />
              <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" />
              <DataGridTextColumn Header="Status" Width="105" Binding="{Binding StatusDisplay}" />
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="2" Background="#26262E" CornerRadius="4" Padding="12,8" Margin="0,10,0,0" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Name="TxtSelectedObjectiveInfo" Text="Select an objective to relocate or view its coordinates." FontSize="12" Foreground="#D0D0D0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnRelocateSelected" Content="📍 Relocate on Map" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" Background="#1E3A20" Foreground="#66BB6A" BorderBrush="#4466BB6A" Click="BtnRelocateSelected_Click" />
                <Button Name="BtnRestoreSingle" Content="↩ Restore Original" Padding="14,6" IsEnabled="False" Background="#3A2A1A" Foreground="#FFA726" BorderBrush="#44FFA726" Click="BtnRestoreSingle_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="📋 Modification History">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#26262E" CornerRadius="4" Padding="12,10" Margin="0,0,0,10" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Name="TxtCustomizedCountHeader" Text="User-customized objectives: 0" FontSize="14" FontWeight="SemiBold" Foreground="#C5A84A" />
                <TextBlock Text="Restored objectives faithfully recover their factory coordinates." FontSize="11" Foreground="#A0A0A5" Margin="0,2,0,0" />
              </StackPanel>
              <Button Name="BtnRestoreAll" Grid.Column="1" Content="🔄 Restore All to Default" Padding="14,6" Background="#3A1A1A" Foreground="#EF5350" BorderBrush="#66EF5350" Click="BtnRestoreAll_Click" />
            </Grid>
          </Border>
          <DataGrid Name="GridHistoryResults" Grid.Row="1" SelectionChanged="GridHistoryResults_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Task" Width="150" Binding="{Binding QuestName}" />
              <DataGridTextColumn Header="Comerciante" Width="90" Binding="{Binding Trader}" />
              <DataGridTextColumn Header="Mapa" Width="90" Binding="{Binding MapName}" />
              <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" />
              <DataGridTextColumn Header="Current Coords" Width="150" Binding="{Binding CurrentCoordinatesDisplay}" />
              <DataGridTextColumn Header="Default Coords" Width="150" Binding="{Binding OriginalCoordinatesDisplay}" />
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="2" Background="#26262E" CornerRadius="4" Padding="12,8" Margin="0,10,0,0" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="TxtSelectedHistoryInfo" Text="Select an objective from history to restore." VerticalAlignment="Center" FontSize="12" Foreground="#D0D0D0" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnHistoryRelocate" Content="📍 Reubicar de Nuevo" Padding="14,6" Margin="0,0,8,0" IsEnabled="False" Background="#1E3A20" Foreground="#66BB6A" BorderBrush="#4466BB6A" Click="BtnHistoryRelocate_Click" />
                <Button Name="BtnHistoryRestore" Content="↩ Restore to Original" Padding="14,6" IsEnabled="False" Background="#3A2A1A" Foreground="#FFA726" BorderBrush="#44FFA726" Click="BtnHistoryRestore_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock Name="TxtStatusMessage" Grid.Row="2" Text="Listo" FontSize="11" Foreground="#888888" Margin="4,8,4,0" />
  </Grid>
</Window>